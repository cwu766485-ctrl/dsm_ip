; Integer arithmetic proof of reduced Q14 numerator range and rounding.
; Complementary to, not a replacement for, the RTL bit-vector miter.
(set-logic QF_LIA)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(assert (and (<= (- 32768) a) (<= a 32767)
             (<= (- 32768) b) (<= b 32767)
             (<= (- 32768) c) (<= c 32767)
             (<= (- 32768) d) (<= d 32767)))
(define-fun n () Int (- (* 9 (+ b c)) (+ a d)))
(push)
(assert (or (< n (- 1048576)) (> n 1048575)))
(check-sat)
(pop)
(define-fun value () Int (* 1024 n))
(define-fun reference () Int
  (ite (>= value 0) (div (+ value 8192) 16384)
    (- (div (+ (- value) 8192) 16384))))
(define-fun candidate () Int (div (+ n (ite (< n 0) 7 8)) 16))
(push)
(assert (not (= reference candidate)))
(check-sat)
(pop)
