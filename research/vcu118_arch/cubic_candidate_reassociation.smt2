; Exact W=16 / 21-bit two's-complement reassociation, no assumptions.
(set-logic QF_BV)
(declare-const xm1 (_ BitVec 16))
(declare-const x0  (_ BitVec 16))
(declare-const xp1 (_ BitVec 16))
(declare-const xp2 (_ BitVec 16))
(define-fun a () (_ BitVec 21) ((_ sign_extend 5) xm1))
(define-fun b () (_ BitVec 21) ((_ sign_extend 5) x0))
(define-fun c () (_ BitVec 21) ((_ sign_extend 5) xp1))
(define-fun d () (_ BitVec 21) ((_ sign_extend 5) xp2))
(define-fun middle () (_ BitVec 21) (bvadd b c))
(define-fun edges () (_ BitVec 21) (bvadd a d))
(define-fun scaled () (_ BitVec 21) (bvshl middle (_ bv3 21)))
(define-fun ca () (_ BitVec 21) (bvsub (bvadd scaled middle) edges))
(define-fun cb () (_ BitVec 21) (bvadd scaled (bvsub middle edges)))
(assert (not (= ca cb)))
(check-sat)
